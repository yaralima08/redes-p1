#!/usr/bin/env python3
import asyncio
import re

import tcp


def validar_nome(nome):
    return re.match(br'^[a-zA-Z][a-zA-Z0-9_-]*$', nome) is not None


# ---------------------------------------------------------------------------
# Estado global do servidor
# ---------------------------------------------------------------------------
conexoes = set()                 # todas as conexões ativas
apelidos = {}                    # apelido (minúsculo) -> Conexao
canais = {}                      # nome do canal (minúsculo) -> {apelido_min: Conexao}
canal_nome_original = {}         # nome do canal (minúsculo) -> nome do canal como foi criado


def decode(b):
    return b.decode('utf-8', errors='replace')


def enviar(conexao, linha):
    conexao.enviar((linha + '\r\n').encode())


def usuarios_relacionados(conexao):
    """Conexões que compartilham ao menos um canal com `conexao` (exclui ela mesma)."""
    resultado = set()
    for canal_lower in getattr(conexao, 'canais', set()):
        membros = canais.get(canal_lower, {})
        resultado.update(membros.values())
    resultado.discard(conexao)
    return resultado


def enviar_lista_nomes(conexao, prefixo, nomes):
    """Quebra a lista de membros em várias mensagens 353 de no máximo 512 bytes."""
    atual = prefixo
    for nome in nomes:
        vazio = atual == prefixo
        candidato = atual + (nome if vazio else ' ' + nome)
        if len((candidato + '\r\n').encode()) > 512:
            enviar(conexao, atual)
            atual = prefixo + nome
        else:
            atual = candidato
    enviar(conexao, atual)


# ---------------------------------------------------------------------------
# Tratamento de cada comando
# ---------------------------------------------------------------------------
def tratar_nick(conexao, args):
    if not args:
        return
    novo = args[0]
    apelido_atual = getattr(conexao, 'apelido', None)

    if not validar_nome(novo):
        atual_str = decode(apelido_atual) if apelido_atual else '*'
        enviar(conexao, f":server 432 {atual_str} {decode(novo)} :Erroneous nickname")
        return

    novo_lower = novo.lower()
    if novo_lower in apelidos and apelidos[novo_lower] is not conexao:
        atual_str = decode(apelido_atual) if apelido_atual else '*'
        enviar(conexao, f":server 433 {atual_str} {decode(novo)} :Nickname is already in use")
        return

    if apelido_atual is None:
        # Registro inicial
        conexao.apelido = novo
        conexao.canais = getattr(conexao, 'canais', set())
        apelidos[novo_lower] = conexao
        enviar(conexao, f":server 001 {decode(novo)} :Welcome")
        enviar(conexao, f":server 422 {decode(novo)} :MOTD File is missing")
    else:
        # Troca de apelido já registrado
        del apelidos[apelido_atual.lower()]
        conexao.apelido = novo
        apelidos[novo_lower] = conexao

        # Atualiza as listas de membros dos canais em que ele está
        for canal_lower in getattr(conexao, 'canais', set()):
            membros = canais.get(canal_lower)
            if membros is not None:
                membros.pop(apelido_atual.lower(), None)
                membros[novo_lower] = conexao

        msg = f":{decode(apelido_atual)} NICK {decode(novo)}"
        destinatarios = usuarios_relacionados(conexao)
        destinatarios.add(conexao)
        for c in destinatarios:
            enviar(c, msg)


def tratar_privmsg(conexao, args):
    if not hasattr(conexao, 'apelido') or len(args) < 2:
        return
    destino, conteudo = args[0], args[1]
    destino_lower = destino.lower()
    msg = f":{decode(conexao.apelido)} PRIVMSG {decode(destino)} :{decode(conteudo)}"

    if destino.startswith(b'#'):
        membros = canais.get(destino_lower)
        if not membros:
            return
        for c in membros.values():
            if c is not conexao:
                enviar(c, msg)
    else:
        alvo = apelidos.get(destino_lower)
        if alvo:
            enviar(alvo, msg)


def tratar_join(conexao, args):
    if not hasattr(conexao, 'apelido') or not args:
        return
    canal = args[0]

    if not (canal.startswith(b'#') and validar_nome(canal[1:])):
        enviar(conexao, f":server 403 {decode(canal)} :No such channel")
        return

    canal_lower = canal.lower()
    if canal_lower not in canais:
        canais[canal_lower] = {}
        canal_nome_original[canal_lower] = canal
    canal_exibicao = canal_nome_original[canal_lower]

    membros = canais[canal_lower]
    membros[conexao.apelido.lower()] = conexao
    conexao.canais = getattr(conexao, 'canais', set())
    conexao.canais.add(canal_lower)

    msg_join = f":{decode(conexao.apelido)} JOIN :{decode(canal_exibicao)}"
    for c in membros.values():
        enviar(c, msg_join)

    nomes = sorted((c.apelido.decode() for c in membros.values()), key=str.lower)
    prefixo = f":server 353 {decode(conexao.apelido)} = {decode(canal_exibicao)} :"
    enviar_lista_nomes(conexao, prefixo, nomes)
    enviar(conexao, f":server 366 {decode(conexao.apelido)} {decode(canal_exibicao)} :End of /NAMES list.")


def tratar_part(conexao, args):
    if not hasattr(conexao, 'apelido') or not args:
        return
    canal = args[0]
    canal_lower = canal.lower()
    membros = canais.get(canal_lower)
    if not membros or conexao.apelido.lower() not in membros:
        return

    canal_exibicao = canal_nome_original.get(canal_lower, canal)
    msg = f":{decode(conexao.apelido)} PART {decode(canal_exibicao)}"
    for c in membros.values():
        enviar(c, msg)

    membros.pop(conexao.apelido.lower(), None)
    conexao.canais.discard(canal_lower)
    if not membros:
        del canais[canal_lower]
        canal_nome_original.pop(canal_lower, None)


def processar_linha(conexao, linha):
    partes = linha.split(b' ')
    comando = partes[0].upper()

    # Faz o parsing dos parâmetros no estilo IRC: o último parâmetro pode
    # começar com ':' e conter espaços.
    args = []
    i = 1
    while i < len(partes):
        if partes[i].startswith(b':'):
            args.append(b' '.join(partes[i:])[1:])
            break
        elif partes[i]:
            args.append(partes[i])
        i += 1

    if comando == b'PING':
        payload = args[0] if args else b''
        enviar(conexao, f":server PONG server :{decode(payload)}")
    elif comando == b'NICK':
        tratar_nick(conexao, args)
    elif comando == b'PRIVMSG':
        tratar_privmsg(conexao, args)
    elif comando == b'JOIN':
        tratar_join(conexao, args)
    elif comando == b'PART':
        tratar_part(conexao, args)


def sair(conexao):
    apelido = getattr(conexao, 'apelido', None)
    if apelido:
        relacionados = usuarios_relacionados(conexao)
        msg = f":{decode(apelido)} QUIT :Connection closed"
        for c in relacionados:
            enviar(c, msg)

        for canal_lower in list(getattr(conexao, 'canais', set())):
            membros = canais.get(canal_lower)
            if membros is not None:
                membros.pop(apelido.lower(), None)
                if not membros:
                    del canais[canal_lower]
                    canal_nome_original.pop(canal_lower, None)

        apelidos.pop(apelido.lower(), None)

    conexoes.discard(conexao)
    conexao.fechar()


# ---------------------------------------------------------------------------
# Recebimento de dados / gerenciamento de conexões
# ---------------------------------------------------------------------------
def dados_recebidos(conexao, dados):
    if not dados:
        # Conexão fechada pelo cliente
        sair(conexao)
        return

    buffer = getattr(conexao, 'residual', b'') + dados
    linhas = buffer.split(b'\r\n')
    conexao.residual = linhas[-1]   # pedaço incompleto fica para a próxima leitura

    for linha in linhas[:-1]:
        if linha:
            processar_linha(conexao, linha)


def conexao_aceita(conexao):
    conexoes.add(conexao)
    conexao.residual = b''
    conexao.registrar_recebedor(dados_recebidos)


if __name__ == '__main__':
    servidor = tcp.Servidor(6667)
    servidor.registrar_monitor_de_conexoes_aceitas(conexao_aceita)
    asyncio.get_event_loop().run_forever()
         

    


